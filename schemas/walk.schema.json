{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastcall.engine/schemas/walk.schema.json",
  "title": "Walk polygons",
  "type": "object",
  "additionalProperties": false,
  "required": ["polygons"],
  "properties": {
    "polygons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["points"],
        "properties": {
          "points": {
            "type": "array",
            "minItems": 3,
            "items": { "$ref": "point.schema.json" }
          },
          "holes": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 3,
              "items": { "$ref": "point.schema.json" }
            }
          }
        }
      }
    }
  }
}
