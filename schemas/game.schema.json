{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lastcall.engine/schemas/game.schema.json",
  "title": "Game",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "version", "startRoom", "hero"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "formatVersion": { "type": "string" },
    "engineMin": { "type": "string" },
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "startRoom": { "type": "string", "minLength": 1 },
    "startSpawn": { "type": "string" },
    "hero": { "type": "string", "minLength": 1 },
    "scoreMax": { "type": "integer" },
    "rngSeed": { "type": "integer", "minimum": 0 },
    "reach": { "type": "integer", "minimum": 0 },
    "intro": { "type": "array", "items": { "type": "string" } },
    "rules": { "type": "array", "items": { "$ref": "rule.schema.json" } },
    "hooks": { "type": "object" },
    "timers": { "type": "array" },
    "declarations": { "type": "object" },
    "carrying": { "type": "array", "items": { "type": "string" } },
    "deathPrompt": { "type": "string" }
  }
}
